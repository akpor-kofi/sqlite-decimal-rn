+/* Mark a function parameter as unused, to suppress nuisance compiler
+** warnings. */
+#ifndef UNUSED_PARAMETER
+# define UNUSED_PARAMETER(X)  (void)(X)
+#endif
+
+#ifndef IsSpace
+#define IsSpace(X)  isspace((unsigned char)X)
+#endif
